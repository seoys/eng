# Copy this file to .env in the repo root (same folder as docker-compose.yml).
# docker-compose reads it automatically.
MONGODB_URI=mongodb://user:password@host:port/eng_quiz?authSource=admin
OPENAI_API_KEY=your-proxy-api-key
OPENAI_BASE_URL=https://api.synterolink.com/v1
OPENAI_MODEL=gpt-5.4-mini
JWT_SECRET=change-me-to-a-random-secret
